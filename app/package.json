{
  "name": "linework-app",
  "version": "1.0.0",
  "private": true,
  "description": "Linework for iOS and Android: scan barcodes into Google Sheets, run events, and get alerts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "check": "tsc -p jsconfig.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.js\"",
    "doctor": "expo-doctor",
    "bundle": "expo export --platform ios --platform android --output-dir dist-check"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/schibsted-grotesk": "0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "~57.0.31",
    "expo-camera": "57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "57.0.2",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "expo-doctor": "^1.21.5",
    "typescript": "6.0.3"
  }
}
