# Linework app configuration. Copy to `.env` (which git ignores) and fill in the values.
#
# EXPO_PUBLIC_ values are compiled into the app, so anyone with the app can read them. Only use
# values designed to be public, such as OAuth client IDs. Never put a client secret, a service
# account key, or an API token here.

# Linework's API (the Cloudflare Worker). For a local server: http://<your computer's LAN IP>:8787
# (phones can't reach "localhost" on your computer), or http://localhost:8787 for the web build.
EXPO_PUBLIC_API_URL=https://linework.stucovitv.in

# Google OAuth clients in the same Google Cloud project as the website (see README.md):
# the Web client (used by Android to request tokens, and by the web build to sign in) ...
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1045236525603-6r4t47890f4140119g8bd2729277ube6.apps.googleusercontent.com
# ... and the iOS client, created for bundle ID in.stucovitv.linework.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1045236525603-lvk42rc1l06ptkr5b2nlsiug4oqm1300.apps.googleusercontent.com
# Android client registered for package in.stucovitv.linework and this computer's debug SHA-1.
# The Android SDK selects it by package and signing certificate; it is not passed to configure().
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1045236525603-cens69fiqfuqus7qtqpbei5eppju18df.apps.googleusercontent.com

# Expo project ID from `npx eas init`; needed for push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
