{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "WebWorker"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/server/**/*.js", "src/server/**/*.d.ts", "src/worker.js", "scripts/**/*.mjs"]
}
