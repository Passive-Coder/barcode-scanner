{
  "name": "linework-barcode-scanner",
  "version": "2.0.0",
  "private": true,
  "description": "Scan barcodes, inspect typed values, and record selected fields in Google Sheets.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply linework --local",
    "db:migrate:remote": "wrangler d1 migrations apply linework --remote",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings && tsc -p jsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run check && npm test && npm run build && npm run db:migrate:remote && npx wrangler deploy"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "gsap": "3.15.0",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.151.2"
  }
}
