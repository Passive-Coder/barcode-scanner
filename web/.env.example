# Linework environment configuration.
# Copy this file to `.env` (which git ignores) and fill in the values.
#
# Variables prefixed with VITE_ are compiled into the browser bundle, so anyone who opens
# the site can read them. Only use values designed to be public, such as an OAuth client ID.
# Never put a Google OAuth client secret, a service account key, or a Cloudflare API token
# in a VITE_ variable.

# Google OAuth 2.0 Web Client ID (Google Cloud Console → APIs & Services → Credentials).
# Its Authorized JavaScript origins must list every origin that serves the app, including
# http://localhost:3000 for local development. The app uses the browser token flow and
# never needs a client secret.
VITE_GOOGLE_CLIENT_ID=

# Port used by `npm run dev` and `npm run preview`. It must match one of the OAuth
# client's Authorized JavaScript origins. Not exposed to the browser.
DEV_PORT=3000
